{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Go: Build Lambdas",
      "type": "shell",
      "command": "GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -ldflags=\"-s -w\" -o lambda/pre_provisioning_hook/bootstrap ./lambda/pre_provisioning_hook && GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -ldflags=\"-s -w\" -o lambda/ota_controller/bootstrap ./lambda/ota_controller && GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -ldflags=\"-s -w\" -o lambda/kill_switch/bootstrap ./lambda/kill_switch",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "Go: Run Unit Tests",
      "type": "shell",
      "command": "go test -v ./...",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "Go: Format Code",
      "type": "shell",
      "command": "gofmt -s -w .",
      "problemMatcher": []
    },
    {
      "label": "Go: Lint Code",
      "type": "shell",
      "command": "golangci-lint run ./...",
      "problemMatcher": []
    },
    {
      "label": "Go: Clean Binaries",
      "type": "shell",
      "command": "rm -f lambda/pre_provisioning_hook/bootstrap lambda/ota_controller/bootstrap lambda/kill_switch/bootstrap && rm -rf .build/*.zip",
      "problemMatcher": []
    },
    {
      "label": "Terraform: Format Files",
      "type": "shell",
      "command": "terraform fmt",
      "problemMatcher": []
    },
    {
      "label": "Terraform: Validate",
      "type": "shell",
      "command": "terraform init -backend=false && terraform validate",
      "problemMatcher": []
    },
    {
      "label": "Terraform: Lint (TFLint)",
      "type": "shell",
      "command": "tflint --init && tflint -f compact",
      "problemMatcher": []
    },
    {
      "label": "Portal: Install Dependencies",
      "type": "shell",
      "command": "npm ci --ignore-scripts",
      "options": {
        "cwd": "${workspaceFolder}/portal"
      },
      "problemMatcher": []
    },
    {
      "label": "Portal: Format Code",
      "type": "shell",
      "command": "npm run format",
      "options": {
        "cwd": "${workspaceFolder}/portal"
      },
      "problemMatcher": []
    },
    {
      "label": "Portal: Lint & Typecheck",
      "type": "shell",
      "command": "npm run lint && npm run typecheck",
      "options": {
        "cwd": "${workspaceFolder}/portal"
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Portal: Run Unit Tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/portal"
      },
      "problemMatcher": []
    },
    {
      "label": "Portal: Build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/portal"
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Security: Audit Workflows (zizmor)",
      "type": "shell",
      "command": "zizmor .github/ && actionlint",
      "problemMatcher": []
    },
    {
      "label": "Security: Audit Dependencies",
      "type": "shell",
      "command": "go run golang.org/x/vuln/cmd/govulncheck@v1.9.0 ./... && cd portal && npm audit && npm audit signatures",
      "problemMatcher": []
    }
  ]
}
