    "@aws-sdk/client-iot": "3.1161.0",
    "@aws-sdk/client-iot-data-plane": "3.1161.0",
    "@aws-sdk/client-ssm": "3.1161.0",
    "@aws-sdk/credential-provider-cognito-identity": "3.972.79",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.5",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
