# Copy: cp terraform.tfvars.example terraform.tfvars
aws_region             = "eu-central-1"
project_name           = "esp32-ztp"
telemetry_topic_prefix = "dt"
log_retention_days     = 7
github_owner_id        = 2912014

# Products (thing groups, provisioning templates, CI roles) default to the
# gateway and vaktus entries in variables.tf. To add a canary or a product,
# copy the whole `products` default from there and edit it here.
